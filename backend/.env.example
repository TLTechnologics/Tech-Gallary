# Tech Gallery 2027 Backend Configuration

# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database:
# For local zero-friction setup without Supabase: sqlite:///./techgallery.db
# For Supabase PostgreSQL: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-DB-HOST]:5432/postgres
DATABASE_URL=sqlite:///./techgallery.db

# Supabase Auth & Storage (Optional for local SQLite mode, required for Supabase cloud)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Fallback Admin Credentials for local standalone testing
ADMIN_EMAIL=admin@techgallery2027.edu
ADMIN_PASSWORD=admintech2027
JWT_SECRET=techgallery2027_super_secure_jwt_secret_key_change_in_production

# College Name configured as "Our College" for internal validation
OUR_COLLEGE_NAME=Tech Gallery Engineering College

