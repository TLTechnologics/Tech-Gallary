# ==============================================================================
# TECH GALLERY 2027 – ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database URL
# For local SQLite zero-friction testing: sqlite:///./techgallery.db
# For Supabase PostgreSQL production: postgresql+psycopg2://postgres:[YOUR_DB_PASSWORD]@[YOUR_DB_HOST]:5432/postgres
DATABASE_URL=sqlite:///./techgallery.db

# Supabase Credentials (from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_KEY=[YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY]
SUPABASE_JWT_SECRET=[YOUR_SUPABASE_JWT_SECRET]

# Administrator Access
ADMIN_EMAIL=admin@techgallery2027.edu
ADMIN_PASSWORD=admintech2027
JWT_SECRET=super_secret_techgallery_2027_production_jwt_key

# Institutional Anchor (Used to check internal vs external participation)
OUR_COLLEGE_NAME=Tech Gallery Engineering College

# Frontend Environment Variables (Place in frontend/.env)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]

